# Frontend dependencies
node_modules/
frontend/node_modules/

# Build outputs
/dist/
/build/
/frontend/dist/
/frontend/build/

# Environment files — never commit real secrets
.env
.env.local
.env.*.local
# Un-ignore example files so they ARE tracked (they contain only empty placeholders)
!.env.example
!**/.env.example

# Python / Django
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.sqlite3
db.sqlite3
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test coverage
coverage/

# OpenWA / WhatsApp data
OpenWA/
