# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.
#
#   cp .env.example .env
#
# Every key below is optional; the values shown are the defaults baked into
# config/settings.py unless noted otherwise.

# ─── Django ───────────────────────────────────────────────────────────────
# No default exists in settings.py — without this key the dev-only fallback
# string is used, which is fine locally but must be set for any deployment.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# settings.py defaults to ['*'] when unset.
# ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (MySQL) ─────────────────────────────────────────────────────
# settings.py defaults: NAME=rto USER=root PASSWORD=root HOST=localhost PORT=3306
# DB_NAME=rto
# DB_USER=root
# DB_PASSWORD=root
# DB_HOST=localhost
# DB_PORT=3306

# ─── CORS / session ───────────────────────────────────────────────────────
# FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── SMTP / email ─────────────────────────────────────────────────────────
# Setting BOTH EMAIL_HOST_USER and EMAIL_HOST_PASSWORD to non-empty values
# switches EMAIL_BACKEND from the console backend to real SMTP. Until then,
# login OTPs and verification emails are only printed to the server console.

# Gmail — requires 2-Step Verification and an App Password
# (Account -> Security -> 2-Step Verification -> App passwords).
# The App Password is the 16-character code, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Port 465 uses implicit TLS instead; keep EMAIL_USE_TLS=False when you set it.
# EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=your-gmail@gmail.com

# Outlook / Hotmail
# EMAIL_HOST=smtp-mail.outlook.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True

# SendGrid
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_USER_PASSWORD=SG.xxxxx

# Seconds to wait on the SMTP socket before giving up. Without this a dead
# mail host hangs the request and the UI just shows "Login failed".
# EMAIL_TIMEOUT=15

# Escape hatch — overrides the auto-detection above.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# ─── WhatsApp / OpenWA ───────────────────────────────────────────────────────
# Set WHATSAPP_PROVIDER=openwa to use a self-hosted OpenWA REST gateway.
# Leave as 'auto' to auto-detect based on which credentials are supplied.
WHATSAPP_PROVIDER=auto

# Meta Cloud API (if using WhatsApp Business API instead of OpenWA)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# OpenWA self-hosted gateway
# URL of your running OpenWA instance (default: http://localhost:2785 from docker-compose.dev.yml)
# OPENWA_SERVER_URL=http://localhost:2785
# OPENWA_BASE_URL=http://localhost:2785
# The session name or UUID to use (create one via the OpenWA dashboard after scanning QR)
# OPENWA_SESSION_ID=default
# The API master key set in your OpenWA container (API_MASTER_KEY in the root .env)
# OPENWA_API_KEY=

# ─── Throttling ───────────────────────────────────────────────────────────
# LOGIN_THROTTLE_RATE=5/hour
# OTP_THROTTLE_RATE=10/hour
# REGISTER_THROTTLE_RATE=10/hour
# PASSWORD_RESET_THROTTLE_RATE=5/hour
