# --- Root-level environment variables ----------------------------------------
# These are read by docker-compose.dev.yml (OpenWA container).
# Copy this file to .env and fill in real values.
#
#   cp .env.example .env        (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env (PowerShell)
#
# .env is gitignored — NEVER commit it.

# --- OpenWA API security ------------------------------------------------------
# The master API key that secures the OpenWA REST gateway.
# Generate a strong random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_MASTER_KEY=

# --- Docker / compose tuning (optional) --------------------------------------
# Defaults are already set in docker-compose.dev.yml; override here only if needed.
# BIND_HOST=127.0.0.1
# API_PORT=2785
# NODE_ENV=development
# TZ=UTC
# LOG_LEVEL=info
# ENGINE_TYPE=baileys
# AUTO_START_SESSIONS=true
# DATABASE_TYPE=sqlite
# OPENWA_PIDS_LIMIT=2048
# OPENWA_MEM_LIMIT=2g
